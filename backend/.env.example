# Example environment variables; backend reads OS environment variables directly.
NPCORTEX_HOST=127.0.0.1
NPCORTEX_PORT=8765
NPCORTEX_OLLAMA_URL=http://127.0.0.1:11434
NPCORTEX_MODEL=qwen3:8b
# NPCORTEX_PACKS_DIR=F:\\AI\\NPCortex\\character-packs

# A2 local resource limits; optional (uncomment to override defaults).
# NPCORTEX_MAX_SESSIONS=128
# NPCORTEX_SESSION_TTL_SECONDS=1800
# NPCORTEX_MAX_SESSION_REQUESTS=2
# NPCORTEX_SESSION_WAIT_SECONDS=20
# NPCORTEX_MAX_MODEL_REQUESTS=4
# NPCORTEX_MODEL_WAIT_SECONDS=15

# B1 persistent world & actor registry. Save/back up this SQLite file;
# old /v1/chat history remains in RAM for backward compatibility.
# NPCORTEX_DB_PATH=backend/data/npcortex.sqlite3
# NPCORTEX_MAX_TRANSCRIPT_MESSAGES=200

# B3 adds SQLite schema v3, migrated automatically from v1/v2.
# Back up NPCORTEX_DB_PATH with backend STOPPED before opening B3.
# B3 social-run bounds (max_steps 2-24) are per-run, not global environment.
